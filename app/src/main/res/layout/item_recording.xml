<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recording_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/normal_margin"
    android:paddingTop="@dimen/recording_icon_padding"
    android:paddingEnd="@dimen/normal_margin"
    android:paddingBottom="@dimen/recording_icon_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/recording_play_pause"
            android:layout_width="@dimen/recording_icon_size"
            android:layout_height="@dimen/recording_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_recording"
            android:padding="@dimen/recording_icon_padding"
            android:src="@drawable/ic_play_recording_vector"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/normal_margin"
            android:layout_weight="1"
            android:orientation="vertical">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/recording_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textSize="@dimen/bigger_text_size"
                tools:text="Call_20260924_131529" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/recording_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/recording_info_text_size"
                tools:text="2026-09-24 13:15 · 2:30 · 2.3 MB" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/recording_share"
            android:layout_width="@dimen/recording_icon_size"
            android:layout_height="@dimen/recording_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_recording"
            android:padding="@dimen/recording_icon_padding"
            android:src="@drawable/ic_share_recording_vector"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/recording_delete"
            android:layout_width="@dimen/recording_icon_size"
            android:layout_height="@dimen/recording_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_recording"
            android:padding="@dimen/recording_icon_padding"
            android:src="@drawable/ic_delete_recording_vector"
            tools:ignore="UseAppTint" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/recording_playback_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/recording_icon_size"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <SeekBar
            android:id="@+id/recording_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/recording_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recording_icon_padding"
            android:textSize="@dimen/recording_info_text_size"
            tools:text="0:00 / 2:30" />

    </LinearLayout>
</LinearLayout>
